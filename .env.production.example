# Production values for infra/docker/docker-compose.deploy.yml.
#   cp .env.production.example .env.production   (never commit the copy)
# Generate secrets with:  openssl rand -hex 24

# ---- Public hostnames (DNS A records -> this server) ----
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
AUTH_DOMAIN=auth.example.com
ACME_EMAIL=you@example.com

# ---- Infrastructure secrets (must be unique; weak defaults make the API refuse to start) ----
POSTGRES_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=rag-platform
GRAFANA_ADMIN_PASSWORD=

# ---- Web (Auth.js). AUTH_KEYCLOAK_SECRET comes from infra/keycloak/setup-realm.sh ----
AUTH_SECRET=
AUTH_KEYCLOAK_ID=rag-web
AUTH_KEYCLOAK_SECRET=

# ---- Providers (Cloudflare covers both LLM + BGE-M3 embeddings; NVIDIA/Gemini/OpenAI optional) ----
LLM_PROVIDER=cloudflare
EMBEDDING_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
NVIDIA_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
LLM_PRIMARY_MODEL=@cf/meta/llama-3.1-8b-instruct
LLM_MAX_TOKENS=2048
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIMENSIONS=1024
ENABLE_KG_INDEXING=true
KG_EXTRACT_FORMAT=json
KG_MAX_GLEANING=0
RAG_DEFAULT_MODE=auto
COHERE_MAX_RPM=0

# ---- Tuning ----
LOG_LEVEL=info
WORKER_CONCURRENCY=5
MAX_FILE_SIZE_MB=100

# Corporate RAG V2 Adaptive Engine & RetrievalLearningEngine
RERANKER_PROVIDER=auto
CLOUDFLARE_RERANKER_MODEL=@cf/baai/bge-reranker-base
ENABLE_PARENT_CHILD_CHUNKING=true
SHADOW_SAMPLE_RATE=0.02
LEARNING_DAILY_SHADOW_CAP=200

# Cloudflare Tunnel connector token (Dokploy compose only)
TUNNEL_TOKEN=
