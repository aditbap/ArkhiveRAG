# Production values for infra/docker/docker-compose.deploy.yml.
#   cp .env.production.example .env.production   (never commit the copy)
# Generate secrets with:  openssl rand -hex 24

# ---- Release Image Tagging (used for reproducible deploy & rollback) ----
IMAGE_PREFIX=corporate-rag
IMAGE_TAG=v3.1.0

# ---- Public hostnames (DNS A records -> this server) ----
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
AUTH_DOMAIN=auth.example.com
ACME_EMAIL=you@example.com

# ---- Infrastructure secrets (must be unique; weak defaults make the API refuse to start) ----
POSTGRES_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=rag-platform
GRAFANA_ADMIN_PASSWORD=

# ---- Web (Auth.js). AUTH_KEYCLOAK_SECRET comes from infra/keycloak/setup-realm.sh ----
AUTH_SECRET=
AUTH_KEYCLOAK_ID=rag-web
AUTH_KEYCLOAK_SECRET=

# ---- Database Pooling, Read Replica & pgvector HNSW Tuning ----
DATABASE_READ_URL=
DATABASE_POOL_MAX=25
DATABASE_CONNECT_TIMEOUT_S=5
DATABASE_STATEMENT_TIMEOUT_MS=30000
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=30
PGBOUNCER_RESERVE_POOL_SIZE=10
HNSW_EF_SEARCH=64
HNSW_ITERATIVE_SCAN=relaxed_order

# ---- Providers (Cloudflare covers LLM + BGE-M3 embeddings + BGE reranker; OpenAI/Gemini/Cohere optional) ----
LLM_PROVIDER=cloudflare
EMBEDDING_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
LLM_PRIMARY_MODEL=@cf/meta/llama-3.1-8b-instruct
LLM_MAX_TOKENS=2048
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIMENSIONS=1024
ENABLE_KG_INDEXING=true
KG_EXTRACT_FORMAT=json
KG_MAX_GLEANING=0
RAG_DEFAULT_MODE=auto
AGENT_DEFAULT_ENABLED=false
COHERE_MAX_RPM=0

# ---- Tuning & Observability ----
LOG_LEVEL=info
WORKER_CONCURRENCY=5
WORKER_METRICS_PORT=9092
MAX_FILE_SIZE_MB=100
ENABLE_VIRUS_SCAN=true

# ---- Corporate RAG Adaptive Engine & RetrievalLearningEngine ----
RERANKER_PROVIDER=auto
CLOUDFLARE_RERANKER_MODEL=@cf/baai/bge-reranker-base
RERANKER_MODEL=rerank-v3.5
ENABLE_PARENT_CHILD_CHUNKING=true
SHADOW_SAMPLE_RATE=0.02
LEARNING_DAILY_SHADOW_CAP=200

# ---- Optional Cloudflare Tunnel token (Dokploy compose only) ----
TUNNEL_TOKEN=
