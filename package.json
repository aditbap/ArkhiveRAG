{
  "name": "arkhiverag",
  "version": "3.2.0",
  "private": true,
  "description": "ArkhiveRAG — Multi-tenant BYOK Enterprise Adaptive RAG & RBAC Agent Platform on PostgreSQL + pgvector",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aditbap/ArkhiveRAG.git"
  },
  "homepage": "https://github.com/aditbap/ArkhiveRAG#readme",
  "bugs": {
    "url": "https://github.com/aditbap/ArkhiveRAG/issues"
  },
  "keywords": [
    "arkhiverag",
    "rag",
    "pgvector",
    "postgresql",
    "knowledge-graph",
    "agentic-rag",
    "rbac",
    "byok",
    "fastify",
    "nextjs",
    "monorepo"
  ],
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "db:migrate": "pnpm --filter @rag/database db:migrate",
    "db:new": "pnpm --filter @rag/database db:new",
    "db:seed": "tsx scripts/dev/seed.ts",
    "eval:retrieval": "tsx scripts/evaluate-retrieval.ts",
    "ops:verify-plans": "tsx scripts/ops/verify-query-plans.mts",
    "ops:verify-resilience": "tsx scripts/ops/verify-resilience.mts",
    "ops:eval-agent": "tsx scripts/ops/eval-agentic-rag.mts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "turbo": "^2.10.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
