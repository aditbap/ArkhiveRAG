  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "sum(up{job=~\"rag-api|rag-worker\"})", "refId": "A" }],
      "title": "Healthy Targets (API + Worker)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "sum(rate(http_request_duration_seconds_count[5m]))", "refId": "A" }],
      "title": "HTTP Request Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_request_duration_seconds_count[5m])), 1e-6)",
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx Error Ratio",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "sum(increase(rag_redis_degraded_total[15m]))", "refId": "A" }],
      "title": "Redis Degraded Fail-Opens (15m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "title": "HTTP Request Latency (p50 / p95 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(rag_pipeline_stage_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{stage}}", "refId": "A" }
      ],
      "title": "RAG Pipeline Stage p95 Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "targets": [
        { "expr": "rag_db_pool_connections", "legendFormat": "{{state}}", "refId": "A" }
      ],
      "title": "PostgreSQL Connection Pool States",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "targets": [
        { "expr": "ingestion_queue_jobs", "legendFormat": "queue:{{state}}", "refId": "A" },
        { "expr": "worker_active_jobs", "legendFormat": "worker_active", "refId": "B" },
        { "expr": "rate(worker_jobs_total[5m]) * 60", "legendFormat": "jobs/min:{{status}}", "refId": "C" }
      ],
      "title": "Ingestion Queue & Worker Throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 20 },
      "id": 9,
      "targets": [
        { "expr": "rate(rag_chat_cache_hits_total[5m])", "legendFormat": "chat_cache_hits/s", "refId": "A" },
        { "expr": "sum by (reason) (rate(rag_reranker_fallbacks_total[5m]))", "legendFormat": "reranker_fallback:{{reason}}", "refId": "B" },
        { "expr": "sum by (dependency, operation) (rate(rag_dependency_errors_total[5m]))", "legendFormat": "dep_err:{{dependency}}/{{operation}}", "refId": "C" },
        { "expr": "rate(worker_stalled_jobs_total[5m])", "legendFormat": "worker_stalled/s", "refId": "D" }
      ],
      "title": "Cache Hits, Reranker Fallbacks & Dependency Errors",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 27 },
      "id": 10,
      "targets": [
        { "expr": "sum by (tool, outcome) (rate(rag_agent_tool_calls_total[5m]) * 60)", "legendFormat": "tool:{{tool}} ({{outcome}})/min", "refId": "A" },
        { "expr": "sum by (role, code) (increase(rag_agent_policy_denials_total[15m]))", "legendFormat": "denied:{{role}}/{{code}}", "refId": "B" }
      ],
      "title": "RBAC Company Agent Tool Calls & Policy Denials",
      "type": "timeseries"
    }
  ],
