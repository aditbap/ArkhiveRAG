# ============================================================
# RAG Platform — Environment Variables (Bring Your Own Key)
# ============================================================
# Copy this file to .env and enter YOUR own provider API key(s).
# (apps/web has its own apps/web/.env.local — `infra/keycloak/setup-realm.sh`
# writes the AUTH_* values for you.)
# NEVER commit .env to version control.
# ============================================================

# ---- General ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3002
LOG_LEVEL=debug

# ---- Database (PostgreSQL 16 + pgvector, local via docker-compose) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_platform

# ---- Redis (local via docker-compose) ----
REDIS_URL=redis://localhost:6379

# ---- MinIO (S3-compatible object storage, local via docker-compose) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents

# ---- Keycloak (apps/api verifies tokens locally against the realm's JWKS) ----
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=rag-platform

# ---- BYOK LLM Provider (pick ONE: cloudflare | openai | gemini) ----
# Works with Cloudflare Workers AI, OpenAI, Ollama/vLLM/OpenRouter (via OPENAI_BASE_URL), or Gemini.
LLM_PROVIDER=cloudflare
LLM_PRIMARY_MODEL=@cf/meta/llama-3.1-8b-instruct
LLM_MAX_TOKENS=2048

# Cloudflare Workers AI (covers LLM + BGE-M3 embeddings + BGE reranker with one key)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OpenAI or any OpenAI-compatible server (Ollama, vLLM, LiteLLM, Groq, OpenRouter)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (optional)
GEMINI_API_KEY=

# ---- BYOK Embedding Provider (pick ONE: cloudflare | openai | gemini | nvidia) ----
# EMBEDDING_DIMENSIONS MUST be 1024 to match the PostgreSQL vector(1024) HNSW schema:
#   - cloudflare : @cf/baai/bge-m3 (1024 dims, multilingual)
#   - openai     : text-embedding-3-small (auto-requests 1024 dims)
#   - gemini     : gemini-embedding-001 (auto-requests 1024 dims)
EMBEDDING_PROVIDER=cloudflare
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_MS=30000
NVIDIA_API_KEY=

# ---- Reranker (auto | cloudflare | cohere | none) ----
# `auto` prefers Cloudflare @cf/baai/bge-reranker-base when Cloudflare creds exist, else Cohere.
RERANKER_PROVIDER=auto
CLOUDFLARE_RERANKER_MODEL=@cf/baai/bge-reranker-base
COHERE_API_KEY=
RERANKER_MODEL=rerank-v3.5
COHERE_MAX_RPM=0
RERANK_MIN_SCORE=0.1

# ---- Corporate RAG V2 & RetrievalLearningEngine ----
ENABLE_KG_INDEXING=true
KG_EXTRACT_FORMAT=json
KG_MAX_GLEANING=0
RAG_DEFAULT_MODE=auto
ENABLE_PARENT_CHILD_CHUNKING=true
SHADOW_SAMPLE_RATE=0.02
LEARNING_DAILY_SHADOW_CAP=200

# ---- Uploads ----
MAX_FILE_SIZE_MB=100

# ---- OCR (PaddleOCR sidecar, local via docker-compose) ----
OCR_SERVICE_URL=http://localhost:8001

# ---- Virus scanning (ClamAV sidecar, local via docker-compose) ----
ENABLE_VIRUS_SCAN=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ---- Limits / workers ----
RATE_LIMIT_CHAT_PER_MINUTE=20
GUEST_CHAT_ENABLED=true
GUEST_CHAT_PER_IP_PER_MINUTE=6
GUEST_CHAT_PER_IP_PER_DAY=40
GUEST_CHAT_GLOBAL_PER_DAY=1000
RATE_LIMIT_UPLOAD_PER_MINUTE=30
WORKER_CONCURRENCY=5

# ---- Observability (Langfuse tracing; optional) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3100

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- Web app (put these in apps/web/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1
AUTH_SECRET=generate-with-npx-auth-secret
AUTH_KEYCLOAK_ID=rag-web
AUTH_KEYCLOAK_SECRET=your-keycloak-client-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8180/realms/rag-platform
